{
  "name": "enhancely-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Edge/server-side connector that injects Enhancely JSON-LD into customer HTML responses (Cloudflare Workers, CloudFront Lambda@Edge, sidecar proxy)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:module": "pnpm -r build && pnpm --filter @enhancely/adapter-lambda-edge package && cp packages/adapter-lambda-edge/dist/index.js infra/modules/lambda-edge-injector/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
