{
  "name": "@enhancely/adapter-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js reverse-proxy sidecar that injects Enhancely JSON-LD into upstream HTML responses (functional skeleton)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test \"dist/test-build/test/*.test.js\""
  },
  "dependencies": {
    "@enhancely/injector-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
